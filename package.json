{
  "name": "dsh-telegram-relay",
  "displayName": "Telegram Relay",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram relay for DeepSeek Harness: forwards questions, approvals, turn summaries and subagent messages to a bot, with a loopback control panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sflaer/dsh-telegram-relay.git"
  },
  "homepage": "https://github.com/sflaer/dsh-telegram-relay#readme",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "telegram"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check lib/index.js && node --check lib/relay.js && node --check lib/telegram.js && node --check lib/server.js"
  },
  "license": "MIT"
}
